// Lógica para capturar los datos del formulario de tu Landing Page
document.addEventListener("DOMContentLoaded", () => {
  const contactForm = document.getElementById("contactForm") || document.querySelector("form");
  
  if (contactForm) {
    contactForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      
      // Capturamos los campos por ID o por tipo asegurando que no fallen
      const nombreInput = contactForm.querySelector('#nombre') || contactForm.querySelector('input[type="text"]');
      const emailInput = contactForm.querySelector('#email') || contactForm.querySelector('input[type="email"]');
      const mensajeInput = contactForm.querySelector('#mensaje') || contactForm.querySelector('textarea');

      const nombre = nombreInput ? nombreInput.value : "Sin nombre";
      const email = emailInput ? emailInput.value : "Sin email";
      const mensaje = mensajeInput ? mensajeInput.value : "Sin mensaje";

      try {
        await addDoc(collection(db, "leads"), {
          nombre: nombre,
          email: email,
          mensaje: mensaje,
          fecha: new Date().toISOString()
        });

        alert("¡Registro exitoso! Pronto nos pondremos en contacto contigo.");
        contactForm.reset();
      } catch (error) {
        console.error("Error al guardar el contacto: ", error);
        alert("Hubo un error al enviar tus datos. Inténtalo de nuevo.");
      }
    });
  }
});
