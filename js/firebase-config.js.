// Importar Firebase y Firestore desde los CDNs oficiales v11.0.1
import { initializeApp } from "https://www.gstatic.com/firebasejs/11.0.1/firebase-app.js";
import { getFirestore, collection, addDoc } from "https://www.gstatic.com/firebasejs/11.0.1/firebase-firestore.js";

// Tus credenciales reales de Firebase
const firebaseConfig = {
  apiKey: "AIzaSyDuerHqN63gWPae3eH_sTSjXYt0aafCYI0",
  authDomain: "create-your-flow.firebaseapp.com",
  projectId: "create-your-flow",
  storageBucket: "create-your-flow.firebasestorage.app",
  messagingSenderId: "775532885175",
  appId: "1:775532885175:web:195fe7bd3758c53011c932"
};

// Inicializar Firebase y Firestore
const app = initializeApp(firebaseConfig);
export const db = getFirestore(app);

// Lógica de captura del formulario con ID "crmForm"
document.addEventListener("DOMContentLoaded", () => {
  const crmForm = document.getElementById("crmForm");

  if (crmForm) {
    crmForm.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Capturar los valores exactos de tus inputs del HTML
      const nombre = document.getElementById("nombre").value;
      const email = document.getElementById("email").value;
      const telefono = document.getElementById("telefono").value;

      try {
        // Guardar en la colección "leads" de Firestore
        await addDoc(collection(db, "leads"), {
          nombre: nombre,
          email: email,
          telefono: telefono,
          fecha: new Date().toISOString()
        });

        // Mensaje de éxito visible en pantalla para el usuario
        alert("¡Registro exitoso! Pronto nos pondremos en contacto contigo.");
        
        // Limpiar el formulario
        crmForm.reset();
      } catch (error) {
        console.error("Error al guardar en Firestore: ", error);
        alert("Hubo un error al enviar tus datos. Inténtalo de nuevo.");
      }
    });
  }
});
